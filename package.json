{
	"name": "carrera-lti",
	"private": true,
	"version": "3.13.0",
	"license": "CC-BY-NC-4.0",
	"type": "module",
	"main": "dist-electron/main.js",
	"scripts": {
		"dev": "vite",
		"dev:electron": "cross-env VITE_ELECTRON=true vite",
		"build": "tsc -b && vite build",
		"build:electron": "cross-env VITE_ELECTRON=true tsc -b && cross-env VITE_ELECTRON=true vite build && electron-builder",
		"build:electron:ci": "cross-env VITE_ELECTRON=true tsc -b && cross-env VITE_ELECTRON=true vite build && electron-builder --publish never",
		"preview": "vite preview",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"type-check": "tsc -b --noEmit",
		"type-check:electron": "tsc --project tsconfig.electron.json --noEmit",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"setup": "node scripts/setup.mjs",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@blocknote/core": "^0.51.4",
		"@blocknote/mantine": "^0.51.4",
		"@blocknote/react": "^0.51.4",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@google/genai": "^2.8.0",
		"@radix-ui/react-dialog": "^1.1.16",
		"@uiw/react-md-editor": "^4.1.1",
		"@xyflow/react": "^12.11.0",
		"d3-force": "^3.0.0",
		"dexie": "^4.4.3",
		"dexie-react-hooks": "^4.4.0",
		"electron-store": "^11.0.2",
		"firebase": "^12.14.0",
		"framer-motion": "^12.40.0",
		"idb-keyval": "^6.2.5",
		"immer": "^11.1.8",
		"lucide-react": "^1.17.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-force-graph-2d": "^1.29.1",
		"react-router-dom": "^7.17.0",
		"recharts": "^3.8.1",
		"rehype-sanitize": "^6.0.0",
		"uuid": "^14.0.0",
		"y-indexeddb": "^9.0.12",
		"yjs": "^13.6.31",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@clack/prompts": "^1.5.1",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^25.9.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.0.2",
		"@vitejs/plugin-react": "^6.0.2",
		"@vitejs/plugin-react-swc": "^4.3.1",
		"@vitest/coverage-v8": "^4.1.8",
		"cross-env": "^10.1.0",
		"electron": "^42.3.3",
		"electron-builder": "^26.15.0",
		"jsdom": "^29.1.1",
		"memfs": "^4.57.6",
		"picocolors": "^1.1.1",
		"tailwindcss": "^4.2.1",
		"typescript": "~6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-electron": "^1.0.4",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.0"
	},
	"build": {
		"appId": "com.carreralti.app",
		"productName": "Carrera LTI",
		"copyright": "Copyright © 2026 Carrera LTI",
		"directories": {
			"output": "dist-electron/release"
		},
		"files": [
			"dist/**/*",
			"dist-electron/main.js",
			"dist-electron/preload.mjs",
			"dist-electron/electron-store-*.js",
			"scripts/**/*.py",
			"package.json"
		],
		"win": {
			"target": "nsis",
			"icon": "public/icon.ico"
		},
		"mac": {
			"target": "dmg",
			"icon": "public/icon.icns",
			"category": "public.app-category.education"
		},
		"linux": {
			"target": "AppImage",
			"icon": "public/icon.png",
			"category": "Education"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true
		}
	},
	"overrides": {
		"serialize-javascript": "7.0.3",
		"@tailwindcss/vite": {
			"vite": "^8.0.0"
		},
		"vite-plugin-pwa": {
			"vite": "^8.0.0"
		},
		"vite-plugin-electron": {
			"vite": "^8.0.0"
		}
	}
}
